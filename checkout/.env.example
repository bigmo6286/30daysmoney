# ─────────────────────────────────────────────────────────────
#  Checkout · copy to .env. This server never holds keys or funds:
#  buyers pay your wallet directly, the server only watches the chain.
# ─────────────────────────────────────────────────────────────

# Wallet(s) that RECEIVE USDC. Set one or both.
# Solana: your normal wallet address (USDC lands in its USDC token account).
SOL_RECEIVER=
# Base: any 0x address you control.
BASE_RECEIVER=

# Run `npm run keygen` once and paste the private key here. Back it up.
LICENSE_PRIVATE_KEY=

# Shown to buyers after payment (Telegram @handle or email).
CONTACT=

# Sale alerts to your Telegram (optional; can be the same bot as lp-bot).
TG_TOKEN=
TG_OWNER_ID=

# ── optional ─────────────────────────────────────────────────
# SOL_RPC_URL=https://api.mainnet-beta.solana.com   (a Helius/Triton URL is more reliable)
# BASE_RPC_URL=https://mainnet.base.org
# PORT=8787
# PUBLIC_URL=https://pay.example.com
# ORDER_TTL_MIN=60
# POLL_SEC=15
# TRUST_PROXY=1     (only behind your own Caddy/nginx, for per-IP rate limits)
# DATA_DIR=data
