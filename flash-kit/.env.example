# flash-kit · copy to .env. Use a DEDICATED wallet: it owns the executor and pays gas.
PRIVATE_KEY=

# ALCHEMY_KEY= covers Robinhood, Base and Ethereum. Per-chain RPC_URL_* win over it.
# Your own RPCs (public defaults are rate-limited and see your transactions):
# RPC_URL_ROBINHOOD=
# RPC_URL_BASE=
# RPC_URL_ETHEREUM=

# Any other EVM chain with Morpho Blue + Uniswap v3 (use --chain custom):
# CUSTOM_CHAIN_ID=  RPC_URL_CUSTOM=  CUSTOM_MORPHO=  CUSTOM_ROUTER=  CUSTOM_QUOTER=  CUSTOM_FACTORY=  CUSTOM_WETH=

# Solana (sol-* commands)
# SOLANA_RPC_URL=            # else Alchemy from ALCHEMY_KEY, else the public RPC
# SOL_ADDRESS=               # your wallet's address: lets a dry run simulate the full route
# SOL_PRIVATE_KEY=           # only read by --exec; a dedicated wallet holding none of the loan token
# JUPITER_API_KEY=           # optional; the keyless endpoint rate-limits
