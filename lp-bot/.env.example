# ─────────────────────────────────────────────────────────────
#  LP Bot · copy to .env and fill in. NEVER commit or share .env.
# ─────────────────────────────────────────────────────────────

# paper = simulate everything against the real chain, send nothing (default)
# live  = real transactions with WALLET_KEY
MODE=paper

# robinhood | base | arbitrum | custom
CHAIN=robinhood
# Optional: your own RPC (Alchemy etc.). Defaults to the chain's public RPC.
RPC_URL=

# Dedicated wallet for the bot. NEVER your main wallet. Only needed for MODE=live.
# Paper mode can watch any address instead: PAPER_ADDRESS=0x...
WALLET_KEY=

# Telegram: create a bot with @BotFather, get your numeric id from @userinfobot.
# Only TG_OWNER_ID can control the bot; everyone else is ignored.
TG_TOKEN=
TG_OWNER_ID=

# ── optional ─────────────────────────────────────────────────
# DATA_DIR=data
# LOG_LEVEL=info
# Override contract addresses (required for CHAIN=custom):
# CHAIN_ID=
# EXPLORER_URL=
# V3_FACTORY=
# V3_POSITION_MANAGER=
# V3_SWAP_ROUTER02=
# V3_QUOTER_V2=
# WETH=
