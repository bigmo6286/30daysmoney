# ─────────────────────────────────────────────────────────────
#  LP Bot · copy to .env and fill in. NEVER commit or share .env.
# ─────────────────────────────────────────────────────────────

# paper = simulate everything against the real chain, send nothing (default)
# live  = real transactions with WALLET_KEY
MODE=paper

# robinhood | base | arbitrum | custom
CHAIN=robinhood
# Optional RPC. With ALCHEMY_KEY set (and RPC_URL empty) the bot uses Alchemy for this chain and keeps
# the public RPC for eth_getLogs only (Alchemy's free tier allows 10 blocks per getLogs call).
# Otherwise RPC_URL, or the chain's public RPC. LOGS_RPC_URL overrides where getLogs goes.
ALCHEMY_KEY=
RPC_URL=
# LOGS_RPC_URL=

# Dedicated wallet for the bot. NEVER your main wallet. Only needed for MODE=live.
# Paper mode can watch any address instead: PAPER_ADDRESS=0x...
WALLET_KEY=

# Telegram: create a bot with @BotFather, get your numeric id from @userinfobot.
# Only TG_OWNER_ID can control the bot; everyone else is ignored.
TG_TOKEN=
TG_OWNER_ID=

# Token screening for the autopilot (Jev by TypeSafe, https://docs.typesafe.ai).
# Without a key the autopilot won't open anything unless you /set autoScreen off.
TYPESAFE_API_KEY=

# ── optional ─────────────────────────────────────────────────
# JEV_MODEL=jev-latest   (pin e.g. jev-1.13.0 if you tune thresholds against one version)
# DATA_DIR=data
# LOG_LEVEL=info
# Override contract addresses (required for CHAIN=custom):
# CHAIN_ID=
# EXPLORER_URL=
# V3_FACTORY=
# V3_POSITION_MANAGER=
# V3_SWAP_ROUTER02=
# V3_QUOTER_V2=
# WETH=

# Pro license from https://bigmo6286.github.io/30daysmoney/ (checked offline). Empty = free tier:
# manual LP, paper mode, alerts, stop loss / take profit. Pro adds the autopilot, auto-rebalance and the daily report.
LICENSE_KEY=
