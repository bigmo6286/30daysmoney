{
  "name": "lp-bot",
  "version": "0.1.0",
  "description": "Telegram-controlled Uniswap v3 liquidity bot with simulation, paper trading and range automation",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@uniswap/sdk-core": "^7.19.4",
    "@uniswap/v3-sdk": "^3.31.5",
    "ethers": "^6.17.0",
    "jsbi": "^3.2.5",
    "zod": "^3.25.76",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@uniswap/swap-router-contracts": "^1.3.1",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "hardhat": "^2.29.1",
    "solc": "^0.8.26",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
