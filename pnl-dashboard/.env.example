# ─────────────────────────────────────────────────────────────
#  PnL dashboard · copy to .env. Read-only: it never needs a private key.
# ─────────────────────────────────────────────────────────────

# Our bots' data folders (exact cost basis + realized PnL). Leave empty if not used.
LPBOT_DATA=../lp-bot/data
LPBOT_CHAIN=robinhood          # robinhood | base | arbitrum (where lp-bot runs)
DLMM_DATA=../dlmm-agent/data

# Wallets to read on-chain: chain:address[:label], comma-separated.
# Add your bot wallets here too: their open positions then show live value and PnL.
# chains: robinhood, base, arbitrum (Uniswap v3), solana (Meteora DLMM)
WALLETS=

# Listen on localhost by default. To expose it, set HOST=0.0.0.0 AND a password (12+ chars),
# and put it behind HTTPS (see docker-compose.yml).
HOST=127.0.0.1
PORT=8790
DASHBOARD_PASSWORD=

# ── optional ─────────────────────────────────────────────────
# ALCHEMY_KEY=   one key for the EVM chains (enable Robinhood, Base and Arbitrum on the Alchemy app).
#                Solana stays on RPC_SOLANA / the public RPC: Alchemy's free tier refuses the position scan.
# RPC_ROBINHOOD= RPC_BASE= RPC_ARBITRUM= RPC_SOLANA=   (per-chain overrides; public RPCs when nothing is set)
# REFRESH_SEC=120
# DATA_DIR=data        (data/wallets.json: [{"chain":"base","address":"0x…","label":"main"}])
