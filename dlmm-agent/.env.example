# ─────────────────────────────────────────────────────────────
#  DLMM Agent · copy to .env and fill in. NEVER commit or share .env.
# ─────────────────────────────────────────────────────────────

# paper = read real pools, simulate positions, send nothing (default)
# live  = real transactions signed with WALLET_KEY
MODE=paper

# Solana RPC. The public one rate-limits hard: set ALCHEMY_KEY (free tier works) or RPC_URL (Helius / Triton / QuickNode).
# RPC_URL wins when both are set; with neither, the public RPC is used.
ALCHEMY_KEY=
RPC_URL=

# Dedicated wallet for the agent. NEVER your main wallet. Only needed for MODE=live.
# base58 secret key (Phantom "export private key") or a JSON byte array ([12,34,...]).
# Paper mode can watch any address instead: PAPER_ADDRESS=...
WALLET_KEY=

# Telegram: create a bot with @BotFather, get your numeric id from @userinfobot.
TG_TOKEN=
TG_OWNER_ID=

# Token screening with Jev (https://docs.typesafe.ai). Without it the autopilot opens
# nothing unless you /set screen off.
TYPESAFE_API_KEY=

# ── optional ─────────────────────────────────────────────────
# JUPITER_API_KEY=          (higher rate limits; the keyless lite API is used otherwise)
# JEV_MODEL=jev-latest
# DATA_DIR=data
# LOG_LEVEL=info
